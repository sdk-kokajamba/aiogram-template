# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Token from @BotFather (required)
BOT_TOKEN=
# Comma-separated Telegram user IDs that can use admin commands, e.g. 123456789,987654321
ADMIN_IDS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite is fine for local development. Use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+asyncpg://bot:change-me@localhost:5432/bot
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Log every SQL statement
DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# FSM storage
# ---------------------------------------------------------------------------
# Leave empty to keep FSM state in memory (it is lost on restart), e.g. redis://localhost:6379/0
REDIS_URL=

# ---------------------------------------------------------------------------
# Update delivery
# ---------------------------------------------------------------------------
# Leave WEBHOOK_BASE_URL empty to use long polling.
# For a webhook set a public HTTPS URL and a secret, generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Drop updates that were sent while the bot was offline
DROP_PENDING_UPDATES=false

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Minimum number of seconds between two messages from one user (0 disables throttling)
THROTTLE_RATE_LIMIT=0.5

# ---------------------------------------------------------------------------
# docker compose only (PostgreSQL service). Use URL-safe characters in the password.
# ---------------------------------------------------------------------------
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bot
